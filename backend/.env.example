# Database configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./recruiter_ai.db
# For PostgreSQL: postgresql://username:password@localhost:5432/dbname

# Redis configuration for cache-aside and blacklisting
REDIS_URL=redis://localhost:6379/0

# JWT Auth security (Change in production!)
JWT_SECRET=super-secret-key-change-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60
