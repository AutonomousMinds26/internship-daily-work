# ==========================================
# RecruiterAI Platform Configuration (.env)
# ==========================================

# --- Environment & Server ---
ENVIRONMENT=development
DEBUG=true

# --- Database & Storage ---
# Local SQLite default:
DATABASE_URL=sqlite:///./recruiter_ai.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/recruiter_ai

# --- Redis & Celery Task Worker ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Security & JWT Authentication ---
JWT_SECRET=super-secret-recruiterai-production-key-change-me-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI & LLM Provider Configuration ---
# Options: groq, openai, anthropic, ollama, mock
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_placeholder_key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- External Integrations Sandbox / Live Toggle ---
# Set to 'false' to enable live external network calls when credentials are supplied
USE_MOCK_APIS=true

# --- Calendar Integrations ---
GOOGLE_CALENDAR_CREDENTIALS=
OUTLOOK_CALENDAR_CREDENTIALS=

# --- Email Notifications (SendGrid / SMTP) ---
SENDGRID_API_KEY=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=recruitment@recruiterai.com

# --- Assessment Providers ---
HACKERRANK_API_KEY=
CODILITY_API_KEY=
METTL_API_KEY=

# --- Background Verification Providers ---
CHECKR_API_KEY=
SPRINGVERIFY_API_KEY=

# --- ATS / Sourcing Feeds ---
GREENHOUSE_API_KEY=
LEVER_API_KEY=
